# Copie ce fichier en ".env" et remplis ce que tu as.
# Rien n'est obligatoire sauf noté "requis".

# Clé API Anthropic (optionnel, active la couche IA d'enrichissement/désambiguïsation)
ANTHROPIC_API_KEY=

# Adresse utilisée pour le HELO/MAIL FROM lors de la vérification SMTP (recommandé : mets ton vrai domaine)
SMTP_FROM_ADDRESS=verif@tondomaine.fr
SMTP_HELO_DOMAIN=tondomaine.fr
SMTP_TIMEOUT=8

# Si le port 25 est bloqué chez toi, renseigne une API tierce de vérification email (optionnel)
FALLBACK_VERIFY_API_URL=
FALLBACK_VERIFY_API_KEY=

# Clé SerpAPI (optionnel, améliore nettement la fiabilité de recherche du LinkedIn/domaine vs DuckDuckGo gratuit)
SERPAPI_KEY=
